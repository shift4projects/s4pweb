{
  "name": "shift4-projects-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Shift 4 Projects: production studio portfolio site",
  "scripts": {
    "dev": "NODE_ENV=development tsx --env-file-if-exists=.env server/index.ts",
    "build": "vite build",
