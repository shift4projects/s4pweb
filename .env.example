# Resend (contact form email). Without a key, leads still save to the database.
RESEND_API_KEY=
CONTACT_TO=            # where inquiries land, e.g. hello@shift4-projects.com
CONTACT_FROM=Shift 4 Projects <site@shift4-projects.com>   # must be a Resend-verified domain
# Where the SQLite file lives. On Railway, point this at the mounted volume (e.g. /data).
DATA_DIR=./data
# Optional: protects GET /api/leads (CSV export). Leave empty to disable the endpoint.
ADMIN_TOKEN=
PORT=5260

# MCP: enables /mcp (Authorization: Bearer <token>) and /mcp/<token>. Leave empty to disable.
MCP_TOKEN=
# Base URL used in links the MCP returns
SITE_URL=https://shift4-projects.com

# Admin panel (/admin) + login for the MCP OAuth connector. Leave empty to disable both.
ADMIN_PASSWORD=
# Optional: AUTO_REPLY=off stops the instant reply to inquirers (needs RESEND_API_KEY + CONTACT_FROM to send at all)
AUTO_REPLY=
# Tracking. Leave empty to load no tags.
GA_MEASUREMENT_ID=        # G-XXXXXXX (comma-separate to add AW-...)
GOOGLE_ADS_CONVERSION=    # optional AW-123456789/label
META_PIXEL_ID=
# Extra hostnames OAuth should answer on (SITE_URL, its www/apex twin and the Railway domain are automatic)
OAUTH_HOSTS=

# Other domains that forward (301) to SITE_URL, comma separated
REDIRECT_HOSTS=www.shift4projects.com,shift4-projects.com,www.shift4-projects.com

# Inbox assistant (office@ forwards to an AgentMail inbox; Claude reads each email into project memory)
ANTHROPIC_API_KEY=            # Will's Anthropic key; leave empty to keep the assistant idle
AGENT_MODEL=claude-sonnet-5-5 # or "stub" for a no-API local test
AGENTMAIL_API_KEY=
AGENTMAIL_INBOX_ID=           # e.g. shift4@agentmail.to
AGENTMAIL_WEBHOOK_SECRET=     # from the webhook object (Svix); or use AGENT_WEBHOOK_TOKEN in the URL instead
AGENT_WEBHOOK_TOKEN=
AGENT_INTERNAL_DOMAINS=shift4projects.com
DIGEST_TO=                    # defaults to CONTACT_TO
DIGEST_HOUR=7                 # local hour in DIGEST_TZ
DIGEST_TZ=America/Los_Angeles
